{
  "fixture_version": "1",
  "name": "basic-success-and-recovery",
  "initial_state": {"mode": "baseline"},
  "checkpoint_before_execution": true,
  "steps": [
    {
      "module": "fixture.echo",
      "input": "fixture-input",
