{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eria.god.record/1",
  "title": "GOD preserved or derived record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "record_type",
    "sha256",
    "size_bytes",
    "media_type",
    "source",
    "captured_at",
    "parent_record_ids",
    "authority",
    "object_relative_path"
  ],
  "properties": {
    "schema": {
      "const": "eria.god.record/1"
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "record_type": {
      "enum": [
        "original",
        "translation",
        "interpretation",
        "correction"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "label",
        "filename",
        "modified_time_ns",
        "mode"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "modified_time_ns": {
          "type": "integer"
        },
        "mode": {
          "type": "integer"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "root_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "parent_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "authority": {
      "enum": [
        "preserved-source-not-validated-as-fact",
        "derived-not-validated-as-fact"
      ]
    },
    "object_relative_path": {
      "type": "string"
    },
    "validated_parents": {
      "type": "array",
      "description": "Direct-parent identity and integrity proofs captured immediately before the child record is written.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "method",
        "source_context",
        "created_by"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "source_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_path",
            "filename",
            "source_sha256"
          ],
          "properties": {
            "relative_path": {
              "type": "string",
              "minLength": 1
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "original"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "const": "preserved-source-not-validated-as-fact"
          },
          "object_relative_path": {
            "pattern": "^ORIGINAL_DATA/objects/[a-f0-9]{2}/[a-f0-9]{64}$"
          }
        },
        "not": {
          "required": [
            "derivation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "enum": [
              "translation",
              "interpretation",
              "correction"
            ]
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "required": [
          "derivation"
        ],
        "properties": {
          "authority": {
            "const": "derived-not-validated-as-fact"
          },
          "object_relative_path": {
            "pattern": "^DERIVED_DATA/objects/[a-f0-9]{2}/[a-f0-9]{64}$"
          },
          "parent_record_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
