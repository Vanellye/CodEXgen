{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruble-i.invalid/schemas/reviewer-registry.v1.json",
  "title": "Externally governed reviewer public-key registry snapshot",
  "type": "object",
  "required": ["registry_id", "version", "issued_at", "expires_at", "governance_signature", "reviewers"],
  "properties": {
    "registry_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "governance_signature": {"type": "string", "minLength": 1},
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer_id", "role", "key_id", "algorithm", "public_key_b64", "valid_from", "valid_until", "status", "independent_of"],
        "properties": {
          "reviewer_id": {"type": "string"},
          "role": {"type": "string"},
          "key_id": {"type": "string"},
          "algorithm": {"const": "Ed25519"},
          "public_key_b64": {"type": "string"},
          "valid_from": {"type": "string", "format": "date-time"},
          "valid_until": {"type": "string", "format": "date-time"},
          "status": {"enum": ["ACTIVE", "REVOKED", "SUSPENDED", "RETIRED"]},
          "independent_of": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}