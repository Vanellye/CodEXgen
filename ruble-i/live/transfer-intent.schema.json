{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ruble-i/transfer-intent.schema.json",
  "title": "Ruble-I Transfer Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "source_account_ref",
    "beneficiary_id",
    "asset",
    "amount_minor",
    "fee_limit_minor",
    "idempotency_key",
    "created_at",
    "expires_at",
    "purpose",
    "mode"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "source_account_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "description": "Opaque provider/vault reference; never a raw account number."
    },
    "beneficiary_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIAT",
            "TOKEN",
            "NATIVE_COIN"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "network": {
          "type": "string",
          "maxLength": 64
        },
        "token_contract": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 1
    },
    "fee_limit_minor": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mode": {
      "const": "PREPARE_ONLY"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
