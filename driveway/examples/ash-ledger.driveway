project "AshLedger"

ledger "primary":
    currency USD
    mode double_entry
    immutable true

account "wallet":
    type asset
    source ash_wallet
    network avalanche

account "rewards":
    type liability
    unit POINT

rule "points_value":
    1 POINT = 1 USD
    valuation_only true

workflow "reconcile":
    read accounts
    verify entries
    check balances
    require approval before posting
