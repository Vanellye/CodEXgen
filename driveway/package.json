{
  "name":"@driveway-io/starter","version":"0.1.0","private":true,"type":"module",
  "scripts":{
    "dev":"concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web":"vite --host 0.0.0.0",
    "dev:api":"tsx watch src/api/server.ts",
    "start:web":"vite --host 0.0.0.0",
    "start:api":"tsx src/api/server.ts",
    "build":"npm run typecheck && vite build",
    "typecheck":"tsc --noEmit",
    "test":"vitest run",
    "test:watch":"vitest",
    "check":"npm run typecheck && npm test && npm run build",
    "clean":"node -e \"for (const p of ['dist','coverage']) require('node:fs').rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies":{"react":"^19.1.0","react-dom":"^19.1.0"},
  "devDependencies":{"@types/node":"^22.15.0","@types/react":"^19.1.0","@types/react-dom":"^19.1.0","@vitejs/plugin-react":"^4.7.0","concurrently":"^9.2.0","tsx":"^4.20.0","typescript":"^5.8.3","vite":"^6.3.5","vitest":"^3.2.4"}
}
