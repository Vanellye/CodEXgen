# Auth0 development tenant — replace placeholders; never commit real secrets.
DATABASE_URL=postgresql://eria_profile:CHANGE_ME@127.0.0.1:5432/eria_profile
DATABASE_SSL=false

# Exact values from your Auth0 development tenant and custom API.
OIDC_ISSUER=https://YOUR_TENANT_DOMAIN/
OIDC_AUDIENCE=https://eria-financial-tunnel-sandbox.example/api
OIDC_JWKS_URL=https://YOUR_TENANT_DOMAIN/.well-known/jwks.json

# Keep loopback binding unless deployed behind a trusted TLS reverse proxy.
EXTERNAL_PROFILE_HOST=127.0.0.1
EXTERNAL_PROFILE_PORT=8787
