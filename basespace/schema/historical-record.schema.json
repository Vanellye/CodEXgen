{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://basespace.example/schema/historical-record-0.1.schema.json",
  "title":"BaseSpace Canonical Historical Record",
  "type":"object",
  "additionalProperties":false,
  "required":["record_id","title","collection","record_kind","date","source","access","provenance","integrity","revision"],
  "properties":{
    "record_id":{"type":"string","pattern":"^BS-[A-Z0-9-]+$"},
    "title":{"type":"string","minLength":1},
    "alternate_titles":{"type":"array","items":{"type":"string"}},
    "collection":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["HUMAN","LAW","RELIGION","RESTRICTED","SCIENCE","EARTH","LIFE","SPACE","UNKNOWN"]}},
    "record_kind":{"enum":["primary_document","manuscript","inscription","artifact","scientific_publication","observation_record","archive_institution","catalogue_record","secondary_study"]},
    "date":{"type":"object","required":["display","certainty"],"properties":{"display":{"type":"string"},"start_year":{"type":["integer","null"]},"end_year":{"type":["integer","null"]},"calendar_system":{"type":["string","null"]},"certainty":{"enum":["exact","approximate","disputed","unknown"]},"notes":{"type":"string"}},"additionalProperties":false},
    "creator_or_authority":{"type":"array","items":{"type":"string"}},
    "language":{"type":"array","items":{"type":"string"}},
    "script":{"type":"array","items":{"type":"string"}},
    "description":{"type":"string"},
    "historical_context":{"type":"string"},
    "source":{"type":"object","required":["institution_or_publisher","catalogue_reference","landing_page","source_type"],"properties":{"institution_or_publisher":{"type":"string"},"catalogue_reference":{"type":["string","null"]},"landing_page":{"type":"string","format":"uri"},"digital_object_uri":{"type":["string","null"]},"source_type":{"enum":["official_catalogue","institutional_description","digital_facsimile","scholarly_edition","published_transcription","research_publication","repository_file"]},"rights_or_terms":{"type":"string"}},"additionalProperties":false},
    "access":{"type":"object","required":["classification","content_acquisition_status","conditions","review_required"],"properties":{"classification":{"enum":["PUBLIC","LICENSED","PERMISSION_REQUIRED","RESTRICTED","SEALED","UNKNOWN"]},"content_acquisition_status":{"enum":["metadata_only","authorized_copy","public_copy","not_acquired","unknown"]},"conditions":{"type":"string"},"permission_reference":{"type":["string","null"]},"review_required":{"type":"boolean"}},"additionalProperties":false},
    "provenance":{"type":"object","required":["registered_at","registered_by","acquisition_method","lineage"],"properties":{"registered_at":{"type":"string","format":"date-time"},"registered_by":{"type":"string"},"acquisition_method":{"enum":["public_catalogue","official_download","licensed_delivery","institutional_request","repository_import","manual_reference_entry","unknown"]},"lineage":{"type":"array","items":{"type":"string"}},"source_snapshot_uri":{"type":["string","null"]},"source_last_checked":{"type":["string","null"],"format":"date"}},"additionalProperties":false},
    "integrity":{"type":"object","required":["algorithm","digest","scope","status"],"properties":{"algorithm":{"const":"SHA-256"},"digest":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"},"scope":{"type":"string"},"byte_length":{"type":["integer","null"],"minimum":0},"computed_at":{"type":["string","null"],"format":"date-time"},"status":{"enum":["not_computed","verified","mismatch","not_applicable"]}},"additionalProperties":false},
    "revision":{"type":"object","required":["revision_id","revision_number","status","supersedes","change_note"],"properties":{"revision_id":{"type":"string"},"revision_number":{"type":"integer","minimum":1},"status":{"enum":["current","superseded","withdrawn","under_review"]},"supersedes":{"type":["string","null"]},"change_note":{"type":"string"}},"additionalProperties":false},
    "interpretations":{"type":"array","items":{"type":"object","required":["kind","text","confidence"],"properties":{"kind":{"enum":["transcription","translation","summary","historical_interpretation","hypothesis","disputed_claim"]},"text":{"type":"string"},"confidence":{"enum":["high","medium","low","unassessed"]},"author_or_model":{"type":"string"},"derived_from_revision":{"type":"string"}},"additionalProperties":false}},
    "tags":{"type":"array","items":{"type":"string"}}
  }
}